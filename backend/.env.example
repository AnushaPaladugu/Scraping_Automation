PORT=5000
NODE_ENV=development
SCRAPER_TIMEOUT=15000
SCRAPER_CONCURRENCY=5
PLAYWRIGHT_HEADLESS=true
DATA_DIR=./data
OUTPUT_DIRECTORY=./exports
LOG_LEVEL=info

# Database configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scraping_automation

# S3 Object Storage configuration
S3_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_UPLOAD_PREFIX=bulk-uploads/
# Optional for S3-compatible providers (Backblaze B2, Cloudflare R2, MinIO, LocalStack)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_EXPIRES_IN=3600
